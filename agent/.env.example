# Local agent settings.

# Point this at the download server Express API (not the web BFF).
# Local: http://localhost:3001  |  Docker Compose: http://server:3001
DOWNLOAD_SERVER_URL=http://localhost:3001

# Must match the download server's Basic Auth credentials.
# Both values can be changed; keep them aligned with the server.
SERVER_USERNAME=admin
SERVER_PASSWORD=bnPj6kT6tfyYMSr68RSBGwLoRqlEjtYW

# Display path shown in completed history.
LIBRARY_DISPLAY_ROOT=./library

# Local filesystem path used when running `npm --prefix agent run dev`.
LIBRARY_ROOT=./library
