# Local agent settings.

# Point this at the download server API.
DOWNLOAD_SERVER_URL=http://localhost:3001

# Must match the download server's MOVER_API_TOKEN when they run on different machines.
MOVER_API_TOKEN=auto-bangumi-local-mover-api-token

# Local folder where the agent writes completed files when run without Docker.
LIBRARY_CONTAINER_ROOT=./library
LIBRARY_DISPLAY_ROOT=./library
