# Library-agent settings for split-machine deployments.

# Required. Must match the download server's MOVER_API_TOKEN.
MOVER_API_TOKEN=DbDB3qugLcPaaT6prcmavVPy8eQkUxGmN46a3mrzotM

# Point this at the download server when the agent runs on another machine.
