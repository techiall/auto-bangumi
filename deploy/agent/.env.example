# Library-agent settings for split-machine deployments.

# Must match the download server's Basic Auth credentials.
# Both values can be changed; keep them aligned with the server.
SERVER_USERNAME=admin
SERVER_PASSWORD=bnPj6kT6tfyYMSr68RSBGwLoRqlEjtYW

# Point this at the download server Express API from the library machine.
# Prefer :3001 so large /source transfers skip the web BFF.
DOWNLOAD_SERVER_URL=http://download-server:3001

# Host folder mounted into the agent container as /library.
HOST_LIBRARY_ROOT=./library
